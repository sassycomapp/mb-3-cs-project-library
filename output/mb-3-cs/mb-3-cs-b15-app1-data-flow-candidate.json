  "cards": [
    {
      "dot": "cyan",
      "title": "One transaction guards the slot",
      "items": [
        "confirm_booking re-checks slot, resource, places, price inside the same transaction",
        "A clash returns the nearest free slots and creates nothing",
        "The browser never decides availability"
      ]
    },
    {
      "dot": "amber",
      "title": "Money never on the browser's word",
      "items": [
        "Every amount is read from the database",
        "Card data stays on the gateway's hosted page",
        "The webhook is verified, idempotent, and applied once in the background"
      ]
    },
    {
      "dot": "rose",
      "title": "The D5 shadow",
      "items": [
        "A payment succeeding after the hold released is recorded, never lost",
        "Reinstated only inside the same transactional re-check",
        "Otherwise refunded in full; the customer and the Owner are notified either way"
      ]
    }
