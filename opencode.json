{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": {
    "edit": {
      "*": "ask"
    },
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "rm -rf *": "deny",
      "rm -r -f *": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git clean -fd*": "deny",
      "*DROP TABLE*": "deny",
      "*DROP DATABASE*": "deny",
      "*TRUNCATE*": "deny",
      "curl*|*sh": "deny",
      "curl*|*bash": "deny",
      "wget*|*sh": "deny",
      "wget*|*bash": "deny"
    },
    "external_directory": {
      "/mnt/c/dev/dev-mb-3-cs/mb-3-cs-app1/**": "allow"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny"
      }
    }
  }
}
